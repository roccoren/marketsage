# API General Settings
PROJECT_NAME="StockScan API"
PROJECT_DESCRIPTION="API for stock data analysis, predictions, and portfolio management"
PROJECT_VERSION="1.0.0"
API_PREFIX="/api"
DEBUG=true
HOST="0.0.0.0"
PORT=8000

# Security Settings
# Warning: This is an example secret key. Generate a secure key for production.
SECRET_KEY="generate-a-secure-secret-key"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM="HS256"

# CORS Settings
CORS_ORIGINS="http://localhost,http://localhost:3000,http://localhost:8000"

# Database Settings
POSTGRES_SERVER="localhost"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="stockscan"
POSTGRES_PORT="5432"

# Redis Settings
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=""
REDIS_CACHE_EXPIRE_SECONDS=3600

# InfluxDB Settings
INFLUXDB_URL="http://localhost:8086"
INFLUXDB_TOKEN="your-influxdb-token"
INFLUXDB_ORG="stockscan"
INFLUXDB_BUCKET="stockdata"

# Email Settings
SMTP_TLS=true
SMTP_PORT=587
SMTP_HOST="smtp.example.com"
SMTP_USER="user@example.com"
SMTP_PASSWORD="your-smtp-password"
EMAILS_FROM_EMAIL="noreply@example.com"
EMAILS_FROM_NAME="StockScan"

# Scheduler Settings
SCHEDULER_TIMEZONE="UTC"
SCHEDULER_MAX_INSTANCES=10
SCHEDULER_MISFIRE_GRACE_TIME=60

# Data Retention Settings
PREDICTION_RETENTION_DAYS=365