# API Settings
PROJECT_NAME=MarketSage API
PROJECT_DESCRIPTION=API for MarketSage ecosystem - stock data analysis, predictions, and portfolio management
PROJECT_VERSION=1.0.0
API_PREFIX=/api
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Security Settings
SECRET_KEY=your-secret-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# CORS Settings
CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:8000

# Database Settings
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=marketsage
POSTGRES_PORT=5432

# Redis Settings
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_CACHE_EXPIRE_SECONDS=3600

# Component Integration Settings
DATAHUB_URL=http://localhost:8001
MARKETSAGE_CORE_URL=http://localhost:8002

# Time Series Data Service Settings
TSDS_HOST=localhost
TSDS_PORT=50051
TSDS_TIMEOUT=30

# RabbitMQ Settings
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# Exchange and Queue Settings
DATA_EXCHANGE=data.exchange
ANALYSIS_EXCHANGE=analysis.exchange
SYSTEM_EXCHANGE=system.exchange
API_NOTIFICATIONS_QUEUE=api.notifications

# Email Settings
SMTP_TLS=true
SMTP_PORT=587
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=
EMAILS_FROM_NAME=

# SMS Settings
SMS_PROVIDER=
SMS_API_KEY=

# Scheduler Settings
SCHEDULER_TIMEZONE=UTC
SCHEDULER_MAX_INSTANCES=10
SCHEDULER_MISFIRE_GRACE_TIME=60

# Data Retention Settings
PREDICTION_RETENTION_DAYS=365